# ============================================================================
# Production Environment — FamilyHealth AI
# ============================================================================
# Copy to .env on your production server. All values below are REQUIRED
# unless marked optional. The app will refuse to start if required secrets
# are missing (validated at startup).
# ============================================================================

# Database (Railway provides these)
PG_HOST=your-railway-pg-host
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=CHANGE_ME
PG_DATABASE=familyhealth
PG_MEM0_DATABASE=mem0_db

# Supabase (REQUIRED)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_SERVICE_KEY=your-service-key

# LLM — Gemini (REQUIRED — primary provider for all tasks in prod)
GEMINI_API_KEY=your-paid-gemini-key
GEMINI_DIAGNOSIS_MODEL=gemini-2.5-flash
GEMINI_REPORT_MODEL=gemini-2.5-flash
GEMINI_FLASH_MODEL=gemini-2.5-flash-lite

# LLM — Qwen (optional — fallback only)
# QWEN_API_KEY=
# QWEN_BASE_URL=https://ollama.com/v1
# QWEN_MODEL=qwen3.5:397b

# LLM — Cerebras (optional — fallback only)
# CEREBRAS_API_KEY=
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# CEREBRAS_MODEL=gpt-oss-120b

# Web search (fallback chain: DDG → LangSearch → Serper → Tavily)
TAVILY_API_KEY=your-tavily-key
SERPER_API_KEYS=key1,key2,key3
LANGSEARCH_API_KEYS=sk-key1,sk-key2,sk-key3

# Embeddings
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMS=768

# LLM routing — leave empty for prod defaults (all → gemini).
# Gemini flash for quality tasks, flash-lite for trivial/chat.
# Only override if you want a specific task on a different provider.
# LLM_ROUTE_CHAT=
# LLM_ROUTE_DIAGNOSIS=
# LLM_ROUTE_REPORT_ANALYSIS=
# LLM_ROUTE_TOPIC_GENERATION=
# LLM_ROUTE_SUMMARIZATION=
# LLM_ROUTE_FACT_EXTRACTION=

# Sentry (recommended — error monitoring, free tier: 5K errors/month)
SENTRY_DSN=https://your-key@sentry.io/your-project

# App (REQUIRED)
APP_ENV=production
LOG_LEVEL=warning
ALLOWED_ORIGINS=https://your-app-domain.com
