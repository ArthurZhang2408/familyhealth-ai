# Database
PG_HOST=localhost
PG_PORT=5432
PG_USER=familyhealth
PG_PASSWORD=changeme
PG_DATABASE=familyhealth
PG_MEM0_DATABASE=mem0_db

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_SERVICE_KEY=your-service-key

# LLM — Gemini (primary provider)
GEMINI_API_KEY=your-gemini-key
GEMINI_DIAGNOSIS_MODEL=gemini-2.5-flash
GEMINI_REPORT_MODEL=gemini-2.5-flash
GEMINI_FLASH_MODEL=gemini-2.5-flash-lite

# LLM — Qwen via Ollama Cloud (dev/fallback)
QWEN_API_KEY=your-ollama-api-key
QWEN_BASE_URL=https://ollama.com/v1
QWEN_MODEL=qwen3.5:397b

# LLM — Cerebras (dev/fallback)
CEREBRAS_API_KEY=your-cerebras-key
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=gpt-oss-120b

# Web search (fallback chain: DDG → LangSearch → Serper → Tavily)
TAVILY_API_KEY=your-tavily-key
SERPER_API_KEYS=key1,key2,key3
LANGSEARCH_API_KEYS=sk-key1,sk-key2,sk-key3

# Embeddings (Gemini — reuses GEMINI_API_KEY for Mem0 vector embeddings)
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMS=768

# LLM routing — provider name per task. Empty = gemini (default).
# Dev environments can override to free providers (cerebras, qwen).
LLM_ROUTE_CHAT=
LLM_ROUTE_DIAGNOSIS=
LLM_ROUTE_REPORT_ANALYSIS=
LLM_ROUTE_TOPIC_GENERATION=
LLM_ROUTE_SUMMARIZATION=
LLM_ROUTE_FACT_EXTRACTION=

# Sentry (optional — error monitoring)
# SENTRY_DSN=https://your-key@sentry.io/your-project

# App
APP_ENV=development
LOG_LEVEL=info

# Comma-separated allowed CORS origins for production
# e.g. https://app.familyhealth.com,https://familyhealth.com
ALLOWED_ORIGINS=
